<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FCArena" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@color/fc_navy</item>
        <item name="android:navigationBarColor">@color/fc_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/fc_gold</item>
        <item name="android:windowBackground">@color/fc_navy</item>
    </style>

    <style name="Theme.FCArena.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fc_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/fc_arena_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.FCArena</item>
    </style>
</resources>
