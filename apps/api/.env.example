DATABASE_URL="postgresql://fcarena:fcarena_dev_password@localhost:5433/fcarena?schema=public"
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"

# Persistent image storage for Tournament logos
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"


# Preferred: one variable copied from Cloudinary
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"

# FC ARENA AI Assistant (read-only, OpenAI-compatible provider)
# Keep the provider key server-side on Railway. Never expose it to NEXT_PUBLIC_* variables.
AI_ASSISTANT_ENABLED=false
AI_PROVIDER_BASE_URL="https://your-provider.example/v1"
AI_PROVIDER_API_KEY="replace-with-provider-api-key"
AI_PROVIDER_MODEL="replace-with-provider-model"
