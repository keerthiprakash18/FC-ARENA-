  @@index([userId])
  @@map("league_war_participants")
}

model LeagueWarMatch {
  id                       String                @id @default(uuid()) @db.Uuid
  warId                    String                @db.Uuid
  sequence                 Int
  leg                      Int                   @default(1)
  homePlayerUserId         String                @db.Uuid
  awayPlayerUserId         String                @db.Uuid
  homeScore                Int?
  awayScore                Int?
  status                   LeagueWarMatchStatus  @default(SCHEDULED)
  resultStatus             LeagueWarResultStatus @default(NONE)
  resultUpdatedByUserId    String?               @db.Uuid
  resultSubmittedByUserId  String?               @db.Uuid
  resultSubmittedByLeagueId String?              @db.Uuid
  resultConfirmedByUserId  String?               @db.Uuid
  proofUrl                 String?               @db.Text
  disputeReason            String?               @db.VarChar(1000)
  walkoverLeagueId         String?               @db.Uuid
  submittedAt              DateTime?
  confirmedAt              DateTime?
  disputedAt               DateTime?
  completedAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  war             LeagueWar @relation(fields: [warId], references: [id], onDelete: Cascade)
  homePlayer      User      @relation("LeagueWarMatchHomePlayer", fields: [homePlayerUserId], references: [id], onDelete: Restrict)
  awayPlayer      User      @relation("LeagueWarMatchAwayPlayer", fields: [awayPlayerUserId], references: [id], onDelete: Restrict)
  resultUpdatedBy User?     @relation("LeagueWarMatchResultUpdater", fields: [resultUpdatedByUserId], references: [id], onDelete: SetNull)

  @@unique([warId, sequence])
  @@index([warId, status])
  @@index([warId, resultStatus])
  @@index([homePlayerUserId])
  @@index([awayPlayerUserId])
  @@map("league_war_matches")
}

model BallonSeason {
