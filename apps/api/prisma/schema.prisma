model LeagueWar {
  id                   String               @id @default(uuid()) @db.Uuid
  name                 String               @db.VarChar(140)
  homeLeagueId         String               @db.Uuid
  awayLeagueId         String               @db.Uuid
  createdByUserId      String               @db.Uuid
  winnerLeagueId       String?              @db.Uuid
  rematchOfWarId       String?              @db.Uuid
  status               LeagueWarStatus      @default(INVITED)
  playerCount          Int
  legType              LeagueWarLegType     @default(SINGLE_LEG)
  pairingMode          LeagueWarPairingMode @default(SLOT)
  winPoints            Int                  @default(3)
  drawPoints           Int                  @default(1)
  lossPoints           Int                  @default(0)
  challengeExpiresAt   DateTime?
  scheduledStartAt     DateTime?
  deadlineAt           DateTime?
  acceptedAt           DateTime?
  homeReadyAt          DateTime?
  awayReadyAt          DateTime?
  homeRosterLockedAt   DateTime?
  awayRosterLockedAt   DateTime?
  rejectedAt           DateTime?
  rejectionReason      String?              @db.VarChar(500)
  cancelledAt          DateTime?
  cancellationReason   String?              @db.VarChar(500)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  homeLeague   League  @relation("LeagueWarHomeLeague", fields: [homeLeagueId], references: [id], onDelete: Cascade)
  awayLeague   League  @relation("LeagueWarAwayLeague", fields: [awayLeagueId], references: [id], onDelete: Cascade)
  winnerLeague League? @relation("LeagueWarWinnerLeague", fields: [winnerLeagueId], references: [id], onDelete: SetNull)
  createdBy    User    @relation("LeagueWarCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  participants LeagueWarParticipant[]
  matches      LeagueWarMatch[]

  @@index([homeLeagueId, status])
  @@index([awayLeagueId, status])
  @@index([createdByUserId])
  @@index([challengeExpiresAt])
  @@index([rematchOfWarId])
  @@map("league_wars")
}

model LeagueWarParticipant {
