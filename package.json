{
  "name": "fc-arena",
  "version": "0.1.0",
  "private": true,
  "description": "FC ARENA football and esports tournament management platform",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names WEB,API \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build": "npm run build:api && npm run build:web",
    "lint": "npm run lint --workspaces --if-present",
    "db:reset:test-data": "npm run db:reset:test-data --workspace=apps/api",
    "check:play-compliance": "node scripts/check-play-store-compliance.mjs",
    "load:test": "node scripts/load-test.mjs",
    "load:test:verify": "node --test tests/load-test.test.mjs",
    "check:data-safety": "node scripts/check-data-safety.mjs",
    "check:final-release": "node scripts/final-release-gate.mjs"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "@nestjs/mau": {
      "undici": "6.28.1",
      "tmp": "0.2.7"
    },
    "prisma": {
      "mysql2": "3.24.5"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
